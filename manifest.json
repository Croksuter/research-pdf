{
  "manifest_version": 3,
  "name": "ResearchPDF",
  "version": "0.1.0",
  "description": "PDF viewer for papers: drawings and reading position follow you across every Chrome profile and device through your own Google Drive.",
  "permissions": ["storage", "alarms", "webNavigation", "declarativeNetRequestWithHostAccess", "identity"],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["pdf-viewer.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
